# Flask session secret
SECRET_KEY=change-me-to-a-long-random-string

# AWS DocumentDB or MongoDB Atlas connection string
# DocumentDB example:
# MONGODB_URI=mongodb://USER:PASS@your-cluster.docdb.amazonaws.com:27017/?tls=true&replicaSet=rs0&readPreference=secondaryPreferred
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/tricipher?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tricipher

# AWS DocumentDB — set true when using Amazon DocumentDB
AWS_DOCUMENTDB=false
MONGODB_TLS=false
MONGODB_TLS_CA_FILE=./certs/rds-combined-ca-bundle.pem

# React dev server CORS (Flask allows these origins with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password rotation (default: 182 days ≈ 6 months)
PASSWORD_ROTATION_DAYS=182
PASSWORD_REMINDER_DAYS=14

# Ollama (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=90
